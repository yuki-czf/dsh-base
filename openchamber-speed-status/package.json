{
    "name":  "openchamber-speed-status",
    "version":  "0.4.0",
    "private":  true,
    "type":  "module",
    "license":  "MIT",
    "description":  "OpenChamber extension: real generation speed (tok/s), TTFT and token usage read from the local OpenCode database.",
    "openchamber":  {
                        "apiVersion":  1,
                        "engines":  {
                                        "openchamber":  "\u003e=2.5.0"
                                    },
                        "contributes":  {
                                            "panel":  {
                                                          "id":  "speed-status",
                                                          "name":  "Speed",
                                                          "icon":  "speed-up-line",
                                                          "entry":  "panel/index.html"
                                                      },
                                            "statusSection":  {
                                                                  "entry":  "status/index.html",
                                                                  "title":  "Speed",
                                                                  "height":  72
                                                              },
                                            "service":  {
                                                            "entry":  "service/main.js",
                                                            "runtime":  "host"
                                                        }
                                        }
                    },
    "scripts":  {
                    "build":  "node scripts/build.mjs",
                    "selftest":  "node scripts/selftest.mjs"
                },
    "devDependencies":  {
                            "@openchamber/sdk":  "2.5.0",
                            "esbuild":  "^0.25.0"
                        }
}