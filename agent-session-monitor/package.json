{
  "name": "agent-session-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local AI agent session monitor: OpenChamber / DSH Desktop / PI-Desktop / ZCode -> Feishu notify + web dashboard",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/web/public','dist/web/public',{recursive:true})\"",
